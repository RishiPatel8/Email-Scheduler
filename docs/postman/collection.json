            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Current User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/api/auth/me",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
