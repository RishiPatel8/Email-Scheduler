# -------------------------------------------------------------
# EMAIL SCHEDULER BACKEND - ENVIRONMENT VARIABLES
# -------------------------------------------------------------
# Note: For Azure App Service, configure these in the Azure Portal
# under Settings > Configuration > Application settings.
# -------------------------------------------------------------

# [REQUIRED IN PRODUCTION] 
# Connection string for your production MySQL/PostgreSQL database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# [REQUIRED IN PRODUCTION] 
# Redis connection for BullMQ
REDIS_HOST="your-redis-host.redis.cache.windows.net"
REDIS_PORT="6380"

# [REQUIRED IN PRODUCTION]
# Change this to a secure random string!
JWT_SECRET="generate-a-secure-random-string-here"

# [REQUIRED IN PRODUCTION]
# The URL where your frontend is hosted (for CORS)
FRONTEND_URL="https://your-frontend-domain.com"

# -------------------------------------------------------------
# OPTIONAL / DEFAULTS
# -------------------------------------------------------------
# Azure will automatically set process.env.PORT, but you can override here
PORT="3001"

# Email throttling (BullMQ Rate Limiting)
MAX_EMAILS_PER_HOUR="200"
DEFAULT_EMAIL_DELAY_MS="2000"
WORKER_CONCURRENCY="5"

# Ethereal Email Credentials (for local testing)
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Firebase Admin Credentials (if using Firebase for auth or notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
