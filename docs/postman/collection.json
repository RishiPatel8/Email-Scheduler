      "response": []
    },
    {
      "name": "Create Campaign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Spring Promotion Campaign\",\n    \"subject\": \"Exclusive discount inside!\",\n    \"body\": \"Hi recipient,\\n\\nWe are offering a 20% discount on all spring items this week. Don't miss out!\",\n    \"startTime\": \"2026-08-20T20:00:00Z\",\n    \"minimumDelay\": \"2000\",\n    \"hourlyLimit\": \"200\",\n    \"leads\": [\n        \"recipient1@example.com\",\n        \"recipient2@example.com\"\n    ]\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/campaigns",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "api",
            "campaigns"
          ]
        }
      },
      "response": []
    },
